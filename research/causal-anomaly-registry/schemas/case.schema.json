{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jpv:labs:causal-anomaly-registry:case:v1",
  "title": "JPV Labs Causal Anomaly Registry Case",
  "type": "object",
  "required": ["case_id","title","status","phenomenon_classes","created_at","claims","evidence","disposition"],
  "properties": {
    "case_id": {"type":"string","pattern":"^CAR-[A-Z0-9-]+$"},
    "title": {"type":"string","minLength":1},
    "status": {"enum":["CAR-0","CAR-1","CAR-2","CAR-3","CAR-4","CAR-5","CAR-6","CAR-7","CAR-8","CAR-9"]},
    "phenomenon_classes": {"type":"array","minItems":1,"items":{"type":"string"}},
    "causal_signatures": {"type":"array","uniqueItems":true,"items":{"enum":["FWD","RETRO","NONLOCAL","SURVIVAL","HISTORY_DIVERGENCE","TEMPORAL_DISPLACEMENT","CAUSAL_LOOP","STATE_INCONSISTENCY"]}},
    "created_at": {"type":"string","format":"date-time"},
    "observed_at": {"type":["string","null"],"format":"date-time"},
    "location": {"type":["string","null"]},
    "claims": {"type":"array","items":{"$ref":"#/$defs/claim"}},
    "evidence": {"type":"array","items":{"$ref":"#/$defs/evidence"}},
    "sources": {"type":"array","items":{"$ref":"#/$defs/source"}},
    "assertions": {"type":"array","items":{"$ref":"#/$defs/assertion"}},
    "experiments": {"type":"array","items":{"$ref":"#/$defs/experiment"}},
    "predictions": {"type":"array","items":{"$ref":"#/$defs/prediction"}},
    "replications": {"type":"array","items":{"$ref":"#/$defs/replication"}},
    "scores": {"$ref":"#/$defs/scores"},
    "contamination": {"$ref":"#/$defs/contamination"},
    "falsification": {"type":"array","items":{"$ref":"#/$defs/falsification"}},
    "disposition": {"$ref":"#/$defs/disposition"},
    "mechanism": {"$ref":"#/$defs/mechanism"},
    "external_confirmation": {"$ref":"#/$defs/externalConfirmation"}
  },
  "$defs": {
    "claim": {"type":"object","required":["claim_id","text","captured_at","prospective"],"properties":{"claim_id":{"type":"string"},"text":{"type":"string","minLength":1},"captured_at":{"type":"string","format":"date-time"},"verbatim":{"type":"boolean"},"prospective":{"type":"boolean"},"target_known_at_capture":{"type":["boolean","null"]},"matches":{"type":"array","items":{"type":"string"}},"misses":{"type":"array","items":{"type":"string"}}}},
    "evidence": {"type":"object","required":["evidence_id","sha256","acquired_at","media_type","signature_status"],"properties":{"evidence_id":{"type":"string"},"sha256":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"},"created_at":{"type":["string","null"],"format":"date-time"},"observed_at":{"type":["string","null"],"format":"date-time"},"acquired_at":{"type":"string","format":"date-time"},"source_id":{"type":["string","null"]},"media_type":{"type":"string"},"original_uri":{"type":["string","null"]},"signature_status":{"enum":["UNSIGNED","VALID","INVALID","UNKNOWN"]},"timestamp_authorities":{"type":"array","items":{"type":"string"}},"transformation_history":{"type":"array","items":{"type":"string"}}}},
    "source": {"type":"object","required":["source_id","source_type"],"properties":{"source_id":{"type":"string"},"source_type":{"enum":["PERSON","PUBLICATION","DATABASE","DEVICE","INSTITUTION","ARCHIVE","OTHER"]},"information_access":{"type":"array","items":{"type":"string"}},"contact_graph":{"type":"array","items":{"type":"string"}}}},
    "assertion": {"type":"object","required":["assertion_id","subject","predicate","value","source_id","confidence"],"properties":{"assertion_id":{"type":"string"},"subject":{"type":"string"},"predicate":{"type":"string"},"value":{},"source_id":{"type":"string"},"confidence":{"type":"number","minimum":0,"maximum":1},"supporting_evidence":{"type":"array","items":{"type":"string"}},"contradicted_by":{"type":"array","items":{"type":"string"}}}},
    "experiment": {"type":"object","required":["experiment_id","hypothesis","protocol_hash","preregistered_at","primary_endpoint","stopping_rule"],"properties":{"experiment_id":{"type":"string"},"hypothesis":{"type":"string"},"protocol_hash":{"type":"string"},"preregistered_at":{"type":"string","format":"date-time"},"randomization_method":{"type":["string","null"]},"blinding_model":{"type":["string","null"]},"sample_size":{"type":["integer","null"],"minimum":1},"stopping_rule":{"type":"string"},"primary_endpoint":{"type":"string"},"secondary_endpoints":{"type":"array","items":{"type":"string"}},"exclusion_rules":{"type":"array","items":{"type":"string"}},"analysis_code_hash":{"type":["string","null"]}}},
    "prediction": {"type":"object","required":["prediction_id","preregistered","commitment_hash","commitment_verified","committed_at","target_generated_at","entropy_bits","exact_match","timestamp_authorities"],"properties":{"prediction_id":{"type":"string"},"preregistered":{"type":"boolean"},"commitment_hash":{"type":"string"},"commitment_verified":{"type":"boolean"},"committed_at":{"type":"string","format":"date-time"},"target_generated_at":{"type":"string","format":"date-time"},"entropy_bits":{"type":"integer","minimum":0},"exact_match":{"type":"boolean"},"timestamp_authorities":{"type":"array","items":{"type":"string"}}}},
    "replication": {"type":"object","required":["replication_id","independent_team","outcome"],"properties":{"replication_id":{"type":"string"},"independent_team":{"type":"string"},"outcome":{"enum":["PASS","FAIL","INCONCLUSIVE"]},"protocol_deviation":{"type":"array","items":{"type":"string"}}}},
    "scores": {"type":"object","properties":{"prospective_capture":{"type":"integer","minimum":0,"maximum":5},"specificity":{"type":"integer","minimum":0,"maximum":5},"independence":{"type":"integer","minimum":0,"maximum":5},"instrumentation":{"type":"integer","minimum":0,"maximum":5},"replication":{"type":"integer","minimum":0,"maximum":5},"conventional_resistance":{"type":"integer","minimum":0,"maximum":5},"causal_relevance":{"type":"integer","minimum":0,"maximum":5},"provenance_integrity":{"type":"integer","minimum":0,"maximum":5},"evidence_quality":{"type":"number","minimum":0,"maximum":1},"discriminatory_power":{"type":"number","minimum":0,"maximum":1},"replication_strength":{"type":"number","minimum":0,"maximum":1},"extraordinary_mechanism_requirement":{"type":"number","minimum":0,"maximum":1}}},
    "contamination": {"type":"object","properties":{"pathways":{"type":"array","items":{"type":"object","required":["name","probability"],"properties":{"name":{"type":"string"},"probability":{"type":"number","minimum":0,"maximum":1}}}},"estimated_score":{"type":"number","minimum":0,"maximum":1}}},
    "falsification": {"type":"object","required":["family","status","notes"],"properties":{"family":{"enum":["WITNESS","MEMORY","LEAKAGE","FRAUD","RECORD","TIMESTAMP","SOFTWARE","INSTRUMENTATION","STATISTICS","SOCIAL_CONTAMINATION","CONVENTIONAL_PHYSICS"]},"status":{"enum":["EXPLAINED","UNSUPPORTED","INCONCLUSIVE","FAILED_TO_EXPLAIN","NOT_APPLICABLE"]},"notes":{"type":"string"}}},
    "disposition": {"type":"object","required":["summary","ordinary_explanation_status"],"properties":{"summary":{"type":"string"},"ordinary_explanation_status":{"enum":["SUFFICIENT","INSUFFICIENT","INCONCLUSIVE"]},"preferred_hypothesis":{"type":["string","null"]},"promotion_blockers":{"type":"array","items":{"type":"string"}}}},
    "mechanism": {"type":"object","properties":{"status":{"enum":["NONE","CANDIDATE","REPRODUCIBLE"]},"manipulated_variables":{"type":"array","items":{"type":"string"}},"reproduced_by":{"type":"array","items":{"type":"string"}}}},
    "externalConfirmation": {"type":"object","properties":{"independent_labs":{"type":"integer","minimum":0},"theory_conflict_replicated":{"type":"boolean"},"scientific_consensus_basis":{"type":["string","null"]},"governed_manual_review":{"type":"boolean"}}}
  }
}
